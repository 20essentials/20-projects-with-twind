---

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('.card').forEach(card => {
    gsap.from(card, {
      filter: 'blur(3vmax)',
      ease: 'power2.inOut',
      opacity: 0,
      y: 50,
      duration: 1,
      scrollTrigger: {
        trigger: card,
        start: 'clamp(top 96%)',
        end: 'clamp(top 90%)',
        scrub: true,
      }
    });
  });
</script>

<section class='am-section'>
  {
    arrayCards.map(({ id, localImage, repo, title }) => (
      <a class='card' href={repo}>
        <img src={baseUrl(localImage)} alt='Img' />
      </a>
    ))
  }
</section>

<style>
  .am-section {
    min-height: 100vh;
    display: grid;
    padding: 2.2vmax;
    gap: 2.2vmax;
    display: grid;
    z-index: 5;
    grid-template-columns: repeat(auto-fit, minmax(17vmax, 1fr));

    @media (width <= 1111px)  {
      padding-bottom: 4vmax;
    }

    .card {
      min-width: 18vmax;
      width: 100%;
      filter: blur(0vmax);

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }
</style>
